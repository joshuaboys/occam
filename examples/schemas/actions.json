{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Occam extract-actions result",
  "type": "object",
  "additionalProperties": false,
  "required": ["actions"],
  "properties": {
    "actions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["owner", "action"],
        "properties": {
          "owner": { "type": "string", "minLength": 1 },
          "action": { "type": "string", "minLength": 1 },
          "due": { "type": "string" }
        }
      }
    }
  }
}
